<?xml version="1.0"?>
<robot name="amr" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Basic geometry (meters) -->
  <xacro:property name="plate_diameter" value="0.40"/>
  <xacro:property name="plate_radius" value="${plate_diameter * 0.5}"/>
  <xacro:property name="plate_thickness" value="0.01"/>

  <xacro:property name="pillar_size" value="0.025"/>
  <xacro:property name="pillar_height" value="0.15"/>
  <xacro:property name="pillar_offset" value="0.1"/>

  <xacro:property name="total_mass" value="12.0"/>
  <xacro:property name="base_height_total" value="${(plate_thickness * 2.0) + pillar_height}"/>

  <xacro:property name="wheel_radius" value="0.05"/>
  <xacro:property name="wheel_width" value="0.025"/>
  <xacro:property name="wheel_mass" value="0.10"/>
  <xacro:property name="wheel_y_offset" value="${plate_radius}"/>
  <xacro:property name="wheel_z" value="${wheel_radius - (plate_thickness * 0.5)}"/>

  <xacro:property name="caster_radius" value="0.0127"/>
  <xacro:property name="caster_width" value="0.02"/>
  <xacro:property name="caster_mass" value="0.05"/>
  <xacro:property name="caster_x_offset" value="${plate_radius - 0.02}"/>
  <xacro:property name="caster_z" value="${wheel_z - wheel_radius + caster_radius}"/>

  <xacro:property name="lidar_height" value="0.05"/>
  <xacro:property name="lidar_x" value="0.0"/>
  <xacro:property name="lidar_y" value="0.0"/>
  <xacro:property name="lidar_z" value="${pillar_height + (plate_thickness * 0.5) - (lidar_height * 0.5) + 0.05}"/>

  <xacro:property name="camera_length" value="0.09"/>
  <xacro:property name="camera_width" value="0.03"/>
  <xacro:property name="camera_height" value="0.03"/>
  <xacro:property name="camera_x" value="${plate_radius - (camera_length * 0.5)}"/>
  <xacro:property name="camera_y" value="0.0"/>
  <xacro:property name="camera_z" value="${pillar_height + plate_thickness + (camera_height * 0.5) + 0.05}"/>

  <xacro:property name="lidar_mass" value="0.20"/>
  <xacro:property name="camera_mass" value="0.10"/>
  <xacro:property name="base_mass" value="${total_mass - (2 * wheel_mass) - (2 * caster_mass) - lidar_mass - camera_mass}"/>

  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${plate_thickness * 0.5}" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <!-- Bottom plate -->
    <visual>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry>
        <cylinder length="${plate_thickness}" radius="${plate_radius}"/>
      </geometry>
      <material name="gray">
        <color rgba="0.6 0.6 0.6 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="${plate_thickness}" radius="${plate_radius}"/>
      </geometry>
    </collision>

    <!-- Top plate -->
    <visual>
      <origin xyz="0 0 ${pillar_height + plate_thickness + 0.05}" rpy="0 0 0"/>
      <geometry>
        <cylinder length="${plate_thickness}" radius="${plate_radius}"/>
      </geometry>
      <material name="light_gray">
        <color rgba="0.75 0.75 0.75 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 ${pillar_height + plate_thickness}" rpy="0 0 0"/>
      <geometry>
        <cylinder length="${plate_thickness}" radius="${plate_radius}"/>
      </geometry>
    </collision>

    <!-- Four pillars -->
    <xacro:macro name="pillar" params="x y">
      <visual>
        <origin xyz="${x} ${y} ${plate_thickness * 0.5 + pillar_height * 0.5 + 0.05}" rpy="0 0 0"/>
        <geometry>
          <box size="${pillar_size} ${pillar_size} ${pillar_height}"/>
        </geometry>
        <material name="dark_gray">
          <color rgba="0.3 0.3 0.3 1.0"/>
        </material>
      </visual>
      <collision>
        <origin xyz="${x} ${y} ${plate_thickness * 0.5 + pillar_height * 0.5}" rpy="0 0 0"/>
        <geometry>
          <box size="${pillar_size} ${pillar_size} ${pillar_height}"/>
        </geometry>
      </collision>
    </xacro:macro>

    <xacro:pillar x="${ pillar_offset}" y="${ pillar_offset}"/>
    <xacro:pillar x="${ pillar_offset}" y="${-pillar_offset}"/>
    <xacro:pillar x="${-pillar_offset}" y="${ pillar_offset}"/>
    <xacro:pillar x="${-pillar_offset}" y="${-pillar_offset}"/>

    <inertial>
      <origin xyz="0 0 ${base_height_total * 0.5}" rpy="0 0 0"/>
      <mass value="${base_mass}"/>
      <inertia
        ixx="${(1.0/12.0) * base_mass * (3 * plate_radius * plate_radius + base_height_total * base_height_total)}"
        iyy="${(1.0/12.0) * base_mass * (3 * plate_radius * plate_radius + base_height_total * base_height_total)}"
        izz="${0.5 * base_mass * plate_radius * plate_radius}"
        ixy="0.0" ixz="0.0" iyz="0.0"/>
    </inertial>
  </link>

  <!-- Wheels -->
  <link name="left_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder length="${wheel_width}" radius="${wheel_radius}"/>
      </geometry>
      <material name="black">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder length="${wheel_width}" radius="${wheel_radius}"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${wheel_mass}"/>
      <inertia
        ixx="${(1.0/12.0) * wheel_mass * (3 * wheel_radius * wheel_radius + wheel_width * wheel_width)}"
        iyy="${0.5 * wheel_mass * wheel_radius * wheel_radius}"
        izz="${(1.0/12.0) * wheel_mass * (3 * wheel_radius * wheel_radius + wheel_width * wheel_width)}"
        ixy="0.0" ixz="0.0" iyz="0.0"/>
    </inertial>
  </link>

  <link name="right_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder length="${wheel_width}" radius="${wheel_radius}"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder length="${wheel_width}" radius="${wheel_radius}"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${wheel_mass}"/>
      <inertia
        ixx="${(1.0/12.0) * wheel_mass * (3 * wheel_radius * wheel_radius + wheel_width * wheel_width)}"
        iyy="${0.5 * wheel_mass * wheel_radius * wheel_radius}"
        izz="${(1.0/12.0) * wheel_mass * (3 * wheel_radius * wheel_radius + wheel_width * wheel_width)}"
        ixy="0.0" ixz="0.0" iyz="0.0"/>
    </inertial>
  </link>

  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel_link"/>
    <origin xyz="0 ${wheel_y_offset} ${wheel_z}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel_link"/>
    <origin xyz="0 ${-wheel_y_offset} ${wheel_z}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- Casters (fixed for now) -->  
  <link name="front_caster_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder length="${caster_width}" radius="${caster_radius}"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder length="${caster_width}" radius="${caster_radius}"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${caster_mass}"/>
      <inertia
        ixx="${(1.0/12.0) * caster_mass * (3 * caster_radius * caster_radius + caster_width * caster_width)}"
        iyy="${0.5 * caster_mass * caster_radius * caster_radius}"
        izz="${(1.0/12.0) * caster_mass * (3 * caster_radius * caster_radius + caster_width * caster_width)}"
        ixy="0.0" ixz="0.0" iyz="0.0"/>
    </inertial>
  </link>

  <link name="rear_caster_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder length="${caster_width}" radius="${caster_radius}"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder length="${caster_width}" radius="${caster_radius}"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${caster_mass}"/>
      <inertia
        ixx="${(1.0/12.0) * caster_mass * (3 * caster_radius * caster_radius + caster_width * caster_width)}"
        iyy="${0.5 * caster_mass * caster_radius * caster_radius}"
        izz="${(1.0/12.0) * caster_mass * (3 * caster_radius * caster_radius + caster_width * caster_width)}"
        ixy="0.0" ixz="0.0" iyz="0.0"/>
    </inertial>
  </link>

  <joint name="front_caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="front_caster_link"/>
    <origin xyz="${caster_x_offset} 0 ${caster_z}" rpy="0 0 0"/>
  </joint>

  <joint name="rear_caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="rear_caster_link"/>
    <origin xyz="${-caster_x_offset} 0 ${caster_z}" rpy="0 0 0"/>
  </joint>

  <!-- Sensors -->
  <link name="lidar_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="${lidar_height}" radius="0.04"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="${lidar_height}" radius="0.04"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${lidar_mass}"/>
      <inertia
        ixx="${(1.0/12.0) * lidar_mass * (3 * 0.04 * 0.04 + lidar_height * lidar_height)}"
        iyy="${(1.0/12.0) * lidar_mass * (3 * 0.04 * 0.04 + lidar_height * lidar_height)}"
        izz="${0.5 * lidar_mass * 0.04 * 0.04}"
        ixy="0.0" ixz="0.0" iyz="0.0"/>
    </inertial>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="${lidar_x} ${lidar_y} ${lidar_z}" rpy="3.14159 0 0"/>
  </joint>

  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${camera_length} ${camera_width} ${camera_height}"/>
      </geometry>
      <material name="blue">
        <color rgba="0.2 0.2 0.8 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${camera_length} ${camera_width} ${camera_height}"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${camera_mass}"/>
      <inertia
        ixx="${(1.0/12.0) * camera_mass * (camera_width * camera_width + camera_height * camera_height)}"
        iyy="${(1.0/12.0) * camera_mass * (camera_length * camera_length + camera_height * camera_height)}"
        izz="${(1.0/12.0) * camera_mass * (camera_length * camera_length + camera_width * camera_width)}"
        ixy="0.0" ixz="0.0" iyz="0.0"/>
    </inertial>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="${camera_x} ${camera_y} ${camera_z}" rpy="0 0 0"/>
  </joint>
</robot>
