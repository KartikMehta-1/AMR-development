<?xml version="1.0"?>
<package format="3">
  <name>amr_voice</name>
  <version>0.1.0</version>
  <description>MCP-oriented voice intent helpers for AMR operator input.</description>
  <maintainer email="kartik@example.com">Kartik</maintainer>
  <license>Proprietary</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>

  <!-- Optional Python runtime dependencies for live wake-word/audio execution:
       sounddevice, openwakeword. Kept out of rosdep because they are installed
       with pip in the AMR voice runtime image. -->

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
