<?xml version="1.0" encoding="UTF-8"?>
<robot name="amr">
  <virtual_joint name="world_joint" type="fixed" parent_frame="world" child_link="base_footprint"/>

  <group name="so101_arm">
    <chain base_link="so101_base_link" tip_link="so101_tool0"/>
  </group>

  <group name="so101_gripper">
    <joint name="so101_gripper"/>
  </group>

  <end_effector
    name="so101_end_effector"
    parent_link="so101_tool0"
    group="so101_gripper"
    parent_group="so101_arm"/>

  <group_state name="home" group="so101_arm">
    <joint name="so101_shoulder_pan" value="0.0"/>
    <joint name="so101_shoulder_lift" value="0.0"/>
    <joint name="so101_elbow_flex" value="0.0"/>
    <joint name="so101_wrist_flex" value="0.0"/>
    <joint name="so101_wrist_roll" value="0.0"/>
  </group_state>

  <group_state name="stow" group="so101_arm">
    <joint name="so101_shoulder_pan" value="0.0"/>
    <joint name="so101_shoulder_lift" value="1.20"/>
    <joint name="so101_elbow_flex" value="-1.60"/>
    <joint name="so101_wrist_flex" value="0.80"/>
    <joint name="so101_wrist_roll" value="0.0"/>
  </group_state>

  <group_state name="ready" group="so101_arm">
    <joint name="so101_shoulder_pan" value="0.0"/>
    <joint name="so101_shoulder_lift" value="-0.40"/>
    <joint name="so101_elbow_flex" value="0.80"/>
    <joint name="so101_wrist_flex" value="-0.40"/>
    <joint name="so101_wrist_roll" value="0.0"/>
  </group_state>

  <group_state name="observe" group="so101_arm">
    <joint name="so101_shoulder_pan" value="0.0"/>
    <joint name="so101_shoulder_lift" value="-0.20"/>
    <joint name="so101_elbow_flex" value="0.60"/>
    <joint name="so101_wrist_flex" value="-0.80"/>
    <joint name="so101_wrist_roll" value="0.0"/>
  </group_state>

  <disable_collisions link1="base_link" link2="chassis_link" reason="Adjacent"/>
  <disable_collisions link1="so101_arm_mount_link" link2="so101_base_link" reason="Adjacent"/>
  <disable_collisions link1="so101_base_link" link2="so101_shoulder_link" reason="Adjacent"/>
  <disable_collisions link1="so101_shoulder_link" link2="so101_upper_arm_link" reason="Adjacent"/>
  <disable_collisions link1="so101_upper_arm_link" link2="so101_lower_arm_link" reason="Adjacent"/>
  <disable_collisions link1="so101_lower_arm_link" link2="so101_wrist_link" reason="Adjacent"/>
  <disable_collisions link1="so101_wrist_link" link2="so101_gripper_link" reason="Adjacent"/>
  <disable_collisions link1="so101_gripper_link" link2="so101_gripper_frame_link" reason="Adjacent"/>
  <disable_collisions link1="so101_gripper_link" link2="so101_tool0" reason="Adjacent"/>
  <disable_collisions link1="so101_gripper_link" link2="so101_wrist_camera_link" reason="Adjacent"/>
  <disable_collisions link1="so101_wrist_camera_link" link2="so101_wrist_camera_optical_frame" reason="Adjacent"/>
</robot>
